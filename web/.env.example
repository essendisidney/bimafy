NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Legacy anon JWT also supported:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Fixed operator id from migration 00002
NEXT_PUBLIC_OPERATOR_ID=00000000-0000-4000-8000-000000000001

# --- M-Pesa Daraja (optional). Without these, STK runs in simulated mode. ---
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Shared secret Safaricom echoes back on the callback URL (?token=...). Required for live mode.
# The database stores only its SHA-256 (private.app_secrets, name 'mpesa_callback'); set both together.
MPESA_CALLBACK_SECRET=
# Optional: defaults to https://$VERCEL_PROJECT_PRODUCTION_URL/api/payments/mpesa/callback on Vercel.
MPESA_CALLBACK_URL=
# --- SMS reminders. Taifa Mobile is used when its key is set, else Africa's Talking; with neither, test mode. ---
TAIFA_MOBILE_API_KEY=
# Taifa Mobile service / sender name on your account (optional).
TAIFA_MOBILE_SERVICE_NAME=
# Africa's Talking (alternative):
# Use username "sandbox" with a sandbox key to try it without spending credit.
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
# Approved alphanumeric sender id (e.g. BIMAFY); leave empty to use the shared short code.
AFRICASTALKING_SENDER_ID=
# --- Morning auto-send (Vercel Cron calls /api/reminders/run at 08:00 Nairobi) ---
# Vercel sends "Authorization: Bearer $CRON_SECRET". It also lets the server issue customer sign-in
# codes for /my. Store its SHA-256 in the database too:
#   insert into private.app_secrets (name, sha256)
#   values ('reminders_cron', encode(extensions.digest('<CRON_SECRET>', 'sha256'), 'hex'))
#   on conflict (name) do update set sha256 = excluded.sha256, updated_at = now();
CRON_SECRET=
# Only "true" actually texts clients; anything else is a dry run that reports what it would send.
REMINDERS_AUTO_SEND=false
# Language of automatic texts: en or sw.
REMINDERS_LANG=en
# --- WhatsApp (optional Meta Cloud API verify) ---
WHATSAPP_VERIFY_TOKEN=bimafy-whatsapp

# --- Partner gateways (optional). Without these, IPRS/NTSA/OCR run in simulated mode. ---
IPRS_API_URL=
IPRS_API_KEY=
NTSA_API_URL=
NTSA_API_KEY=
OCR_API_URL=
OCR_API_KEY=

# --- CRB credit bureau (optional) ---
CRB_API_URL=
CRB_API_KEY=

# Server-only admin key. Never expose this in the browser or as NEXT_PUBLIC_*.
# SUPABASE_SERVICE_ROLE_KEY=
